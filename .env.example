# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BNB Chain — set NEXT_PUBLIC_CHAIN to switch which network the app runs
# against. This is the ONLY thing that selects the network; no runtime
# toggle exists. Defaults to bsc-testnet if unset.
#   NEXT_PUBLIC_CHAIN=bsc-testnet   (default)
#   NEXT_PUBLIC_CHAIN=bsc-mainnet
NEXT_PUBLIC_CHAIN=bsc-testnet

# --- BSC Testnet (used when NEXT_PUBLIC_CHAIN=bsc-testnet) ---
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
NEXT_PUBLIC_ERC8004_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8183_COMMERCE=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
NEXT_PUBLIC_ERC8183_ROUTER=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
NEXT_PUBLIC_ERC8183_POLICY=0x4f4678d4439fec812ac7674bb3efb4c8f5fb78a6

# --- BSC Mainnet (used when NEXT_PUBLIC_CHAIN=bsc-mainnet) ---
# All optional — lib/web3/network.ts already has working defaults for
# these (the values the project owner supplied, 2026-08). Only set these
# if you need to override one, e.g. a dedicated RPC provider instead of
# the public endpoint (recommended for any real indexing — the public RPC
# rate-limits under load).
# NEXT_PUBLIC_RPC_URL_MAINNET=
# NEXT_PUBLIC_ERC8004_REGISTRY_MAINNET=
# NEXT_PUBLIC_ERC8183_COMMERCE_MAINNET=
# NEXT_PUBLIC_ERC8183_ROUTER_MAINNET=
# NEXT_PUBLIC_ERC8183_POLICY_MAINNET=

# AI provider (abstracted — do not hardcode to one model in code).
# Unset AI_PROVIDER_API_KEY = deterministic keyword-based search fallback,
# no external calls. Set it to enable AI-parsed natural-language search.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Worker-only (never exposed to web)
WORKER_INTERNAL_API_KEY=
